{
  "name": "flutter_rtmp_broadcaster Dev Container",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "runArgs": [
    "--privileged"
  ],
  "remoteUser": "vscode",
  "containerEnv": {
    "FLUTTER_ROOT": "/opt/flutter",
    "PUB_CACHE": "/home/vscode/.pub-cache",
    "ANDROID_HOME": "/opt/android-sdk",
    "ANDROID_SDK_ROOT": "/opt/android-sdk"
  },
  "mounts": [
    "source=/dev/bus/usb,target=/dev/bus/usb,type=bind",
    "source=flutter-rtmp-broadcaster-pub-cache,target=/home/vscode/.pub-cache,type=volume",
    "source=flutter-rtmp-broadcaster-gradle-cache,target=/home/vscode/.gradle,type=volume"
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "Dart-Code.dart-code",
        "Dart-Code.flutter"
      ],
      "settings": {
        "dart.flutterSdkPath": "/opt/flutter",
        "dart.sdkPath": "/opt/flutter/bin/cache/dart-sdk",
        "editor.formatOnSave": true
      }
    }
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh"
}
